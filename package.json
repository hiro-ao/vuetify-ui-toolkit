{
  "name": "@hiro-ao/vuetify-ui-toolkit",
  "version": "0.1.0",
  "description": "Reusable Vue components and composables for Vuetify",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --config vite.playground.config.ts",
    "build:playground": "vite build --config vite.playground.config.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@mdi/font": "^7.4.47",
    "vue": "^3.5.0",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0",
    "vuetify": "^3.7.0"
  }
}
